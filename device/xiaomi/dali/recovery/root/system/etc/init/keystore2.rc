# Dali FBE starts Keystore2 only after the static VINTF snapshot, real /vendor,
# and MITEe persistent storage have been prepared by init.recovery.mt6991.rc.
# Before userdata is decrypted, /data is the labelled recovery rootfs path.
service keystore2 /system/bin/keystore2 /data/misc/keystore
    class early_hal
    user keystore
    group keystore readproc log
    task_profiles ProcessCapacityHigh
    rlimit memlock unlimited unlimited
    disabled
