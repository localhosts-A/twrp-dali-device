# Device-node labels and accesses copied only from this Dali's
# /vendor/etc/selinux/vendor_file_contexts and vendor_sepolicy.cil.
type mitee_client_device, dev_type, mlstrustedobject;
type teei_rpmb_device, dev_type;
type bsg_device, dev_type;
type dali_rpmb_device, dev_type;
type persist_block_device, dev_type;
type persist_data_file, file_type, data_file_type;
type mitee_sfs_file, file_type;
type vendor_persist_drm_file, file_type;
type teei_data_file, file_type, data_file_type;
type mitee_data_file, file_type, data_file_type;

# Stock Dali grants this capability to tee-supplicant.  Without it, the UFS
# RPMB descriptor query fails and reports a zero RPMB multiplier to MITEe.
allow tee self:capability sys_rawio;

allow tee mitee_client_device:chr_file { ioctl read write create getattr setattr lock append map unlink open watch watch_reads };
allow tee nfc_device:chr_file { ioctl read write open };
allow tee teei_rpmb_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow tee teei_rpmb_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow tee bsg_device:chr_file { ioctl read write create getattr setattr lock append map unlink open watch watch_reads };
allow tee dali_rpmb_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow tee dali_rpmb_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_gatekeeper_default mitee_client_device:chr_file { ioctl read write open };
allow hal_keymint_default mitee_client_device:chr_file { ioctl read write open };
allow hal_secure_element_default mitee_client_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
# Stock Dali labels the NXP eSE transport node nfc_device and grants this
# exact access to the secure-element HAL.
allow hal_secure_element_default nfc_device:chr_file { ioctl read write open };
allow init persist_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow init persist_data_file:dir mounton;
allow recovery bsg_device:chr_file { ioctl read write getattr lock append open watch watch_reads };
allow recovery persist_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };

# Exact persistent-storage labels and accesses from this Dali's vendor policy.
# KeyMint/Gatekeeper block in OP-TEE session setup when these labels are absent.
allow tee persist_data_file:dir { ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir };
allow tee persist_data_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow tee mitee_sfs_file:dir { ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir };
allow tee mitee_sfs_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow tee teei_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow tee teei_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow tee mitee_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow tee mitee_data_file:file { ioctl read write create getattr lock append map unlink open watch watch_reads };
allow hal_gatekeeper_default persist_data_file:dir { write add_name remove_name search };
allow hal_gatekeeper_default persist_data_file:file { read write create getattr unlink open };
allow hal_keymint_default persist_data_file:dir { ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_keymint_default persist_data_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_keymint_default mitee_sfs_file:dir { ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_keymint_default mitee_sfs_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };
allow hal_keymint_default mitee_data_file:dir { ioctl read write create getattr setattr lock relabelto rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_keymint_default mitee_data_file:file { ioctl read write create getattr setattr lock relabelto append map unlink rename open watch watch_reads };

# Recovery links the vold metadata-FBE implementation directly. The stored
# userdata metadata key is a Keystore2 BLOB in the platform-private vold
# namespace, so this must only be emitted into the Recovery policy.
recovery_only(`
  allow recovery vold_key:keystore2_key {
      convert_storage_key_to_ephemeral
      delete
      get_info
      manage_blob
      rebind
      req_forced_op
      update
      use
  };
  allow recovery keystore:binder call;
  allow recovery keystore_service:service_manager find;
  allow recovery keystore_maintenance_service:service_manager find;
  allow recovery keystore:keystore2 { early_boot_ended delete_all_keys };

  # Synthetic-password blobs are stored in the LockSettings Keystore2 namespace.
  # Recovery only reads and uses them; forced operations need req_forced_op.
  allow recovery locksettings_key:keystore2_key {
      get_info
      req_forced_op
      use
  };

  # The Recovery-linked vold client makes Gatekeeper, Weaver, and KeyMint
  # requests while the FBE metadata map and user DE keys are initialized.
  hal_client_domain(recovery, hal_secure_element)
  binder_call(recovery, hal_weaver_default)
  binder_call(recovery, hal_keymint_default)
  binder_call(recovery, hal_gatekeeper_default)
')

# Recovery's servicemanager runs in recovery rather than the normal
# servicemanager domain. The Dali AIDL crypto daemons use /dev/binder and must
# register through that manager after their TEE initialization completes.
binder_call(keystore, recovery)
binder_call(hal_weaver_default, recovery)
binder_call(hal_keymint_default, recovery)
binder_call(hal_gatekeeper_default, recovery)
allow hal_weaver_default secure_element_service:service_manager find;
