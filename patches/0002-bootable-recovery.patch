+    std::lock_guard<std::mutex> lock(ev_ff_mutex);
+    stop_ev_ff_locked();
+
+    int fd = open_ev_ff_device();
+    if (fd < 0) {
+        LOGI("EV_FF haptics: compatible input device not found\n");
+        return -1;
+    }
+
+    struct ff_effect effect = {};
+    effect.type = FF_PERIODIC;
+    effect.id = -1;
+    effect.replay.length = timeout_ms;
+    effect.u.periodic.waveform = FF_SINE;
+    effect.u.periodic.period = EV_FF_PERIOD_MS;
+    effect.u.periodic.magnitude = EV_FF_MAGNITUDE;
+
+    if (ioctl(fd, EVIOCSFF, &effect) < 0) {
+        LOGI("EV_FF haptics: effect upload failed: %s\n", strerror(errno));
+        close(fd);
+        return -1;
+    }
+    if (!send_ev_ff_event(fd, effect.id, 1)) {
+        LOGI("EV_FF haptics: effect start failed: %s\n", strerror(errno));
+        ioctl(fd, EVIOCRMFF, effect.id);
+        close(fd);
+        return -1;
+    }
+
+    ev_ff_fd = fd;
+    ev_ff_effect_id = effect.id;
