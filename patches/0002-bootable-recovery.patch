+    std::thread([generation, timeout_ms] {
+        usleep((static_cast<useconds_t>(timeout_ms) + EV_FF_STOP_MARGIN_MS) * 1000U);
+        std::lock_guard<std::mutex> lock(ev_ff_mutex);
+        if (generation == ev_ff_generation)
+            stop_ev_ff_locked();
+    }).detach();
+    return 0;
+}
