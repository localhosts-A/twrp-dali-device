+constexpr unsigned short EV_FF_PERIOD_MS = 10;
+constexpr unsigned short EV_FF_MAGNITUDE = 24576;
+constexpr unsigned int EV_FF_STOP_MARGIN_MS = 20;
+constexpr size_t EV_FF_BITS_PER_LONG = sizeof(unsigned long) * 8;
+constexpr size_t EV_FF_BIT_WORDS = (FF_MAX + EV_FF_BITS_PER_LONG) / EV_FF_BITS_PER_LONG;
+
+std::mutex ev_ff_mutex;
+int ev_ff_fd = -1;
+int ev_ff_effect_id = -1;
+unsigned long ev_ff_generation = 0;
+
+bool ev_ff_bit_is_set(const unsigned long* bits, unsigned int bit)
+{
+    return bits[bit / EV_FF_BITS_PER_LONG] & (1UL << (bit % EV_FF_BITS_PER_LONG));
+}
+
+bool is_event_node(const char* name)
+{
+    constexpr char prefix[] = "event";
+    if (strncmp(name, prefix, sizeof(prefix) - 1) != 0)
+        return false;
+
+    const char* suffix = name + sizeof(prefix) - 1;
+    return suffix[0] != '\0' && strspn(suffix, "0123456789") == strlen(suffix);
+}
+
+bool send_ev_ff_event(int fd, int effect_id, int value)
+{
+    struct input_event event = {};
+    event.type = EV_FF;
+    event.code = effect_id;
+    event.value = value;
+
+    ssize_t written;
+    do {
+        written = write(fd, &event, sizeof(event));
+    } while (written < 0 && errno == EINTR);
+    if (written >= 0 && written != static_cast<ssize_t>(sizeof(event)))
+        errno = EIO;
+    return written == static_cast<ssize_t>(sizeof(event));
+}
+
+int open_ev_ff_device()
+{
+    DIR* input_dir = opendir("/dev/input");
+    if (input_dir == nullptr)
+        return -1;
+
+    int selected_fd = -1;
+    struct dirent* entry;
+    while ((entry = readdir(input_dir)) != nullptr) {
+        if (!is_event_node(entry->d_name))
+            continue;
+
+        char path[PATH_MAX];
+        int path_length = snprintf(path, sizeof(path), "/dev/input/%s", entry->d_name);
+        if (path_length < 0 || static_cast<size_t>(path_length) >= sizeof(path))
+            continue;
+
+        int fd = open(path, O_RDWR | O_CLOEXEC);
+        if (fd < 0)
+            continue;
+
+        unsigned long ff_bits[EV_FF_BIT_WORDS] = {};
+        int effect_count = 0;
+        if (ioctl(fd, EVIOCGBIT(EV_FF, sizeof(ff_bits)), ff_bits) < 0 ||
+            !ev_ff_bit_is_set(ff_bits, FF_PERIODIC) ||
+            !ev_ff_bit_is_set(ff_bits, FF_SINE) ||
+            ioctl(fd, EVIOCGEFFECTS, &effect_count) < 0 || effect_count < 1) {
+            close(fd);
+            continue;
+        }
+
+        char device_name[80] = {};
+        ioctl(fd, EVIOCGNAME(sizeof(device_name)), device_name);
+        LOGI("EV_FF haptics: using %s (%s)\n", path,
+             device_name[0] != '\0' ? device_name : "unnamed");
+        selected_fd = fd;
+        break;
+    }
+
+    closedir(input_dir);
+    return selected_fd;
+}
+
+void stop_ev_ff_locked()
+{
+    if (ev_ff_fd < 0)
+        return;
